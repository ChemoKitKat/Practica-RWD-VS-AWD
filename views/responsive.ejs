<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Catálogo Hardware - RWD</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <header>
    <h1>Catálogo de Componentes (Versión RWD)</h1>
  </header>

  <div class="layout">
    <aside class="sidebar">
      <h2>Filtros Avanzados</h2>
      <p>Selección por socket, TDP y consumo.</p>
      
      <div class="heavy-chart-container">
        <h3>Comparativa en Real-Time</h3>
        <p id="chart-render-target">Cargando gráfica...</p>
      </div>
    </aside>

    <main class="grid">
      <% products.forEach(p => { %>
        <article class="card">
          <picture>
            <source media="(max-width: 639px)" srcset="<%= p.imgLow %>">
            <source media="(min-width: 640px)" srcset="<%= p.imgHigh %>">
            <img src="<%= p.imgHigh %>" alt="<%= p.name %>" loading="lazy">
          </picture>
          <h3><%= p.name %></h3>
          <p><strong>Precio:</strong> <%= p.price %></p>
          <table class="specs-table">
            <tr><td>Núcleos:</td><td><%= p.specs.cores %></td></tr>
            <tr><td>RAM:</td><td><%= p.specs.ram %></td></tr>
            <tr><td>Ancho de Banda:</td><td><%= p.specs.throughput %></td></tr>
            <tr><td>Fuente:</td><td><%= p.specs.power %></td></tr>
          </table>
          <button class="btn-buy">Comprar Componente</button>
        </article>
      <% }); %>
    </main>
  </div>

  <!-- El script viaa en el HTML inicial independientemente de la resolución -->
  <script src="/js/heavy-chart.js"></script>
</body>
</html>